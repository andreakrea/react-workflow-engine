{
  "name": "vise-workflow-engine",
  "version": "2.0.0",
  "description": "Graph-based workflow engine with a drag-and-drop React editor. Typed blocks shared by server and editor, pluggable storage, framework-agnostic HTTP handler.",
  "license": "MIT",
  "sideEffects": [
    "*.css",
    "./dist/element.mjs",
    "./dist/element.global.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./knex": {
      "import": {
        "types": "./dist/knex.d.mts",
        "default": "./dist/knex.mjs"
      },
      "require": {
        "types": "./dist/knex.d.ts",
        "default": "./dist/knex.js"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "require": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      }
    },
    "./react/style.css": "./dist/style.css",
    "./element": {
      "import": {
        "types": "./dist/element.d.mts",
        "default": "./dist/element.mjs"
      },
      "default": "./dist/element.global.js"
    },
    "./element.global.js": "./dist/element.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "AGENT.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup && node scripts/build-css.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "dev:demo": "cd demo && npm run dev",
    "deploy:demo": "cd demo && npm run build && cd .. && npx gh-pages -d demo/dist",
    "e2e": "npm run build && playwright test"
  },
  "keywords": [
    "workflow",
    "state-machine",
    "graph",
    "editor",
    "xyflow",
    "express",
    "knex",
    "postgresql",
    "drag-and-drop",
    "react",
    "web-component",
    "custom-element",
    "angular",
    "vue"
  ],
  "peerDependencies": {
    "@xyflow/react": ">=12.0.0 <13",
    "knex": ">=2.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "knex": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@xyflow/react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@xyflow/react": "^12.12.1",
    "better-sqlite3": "^11.10.0",
    "gh-pages": "^6.3.0",
    "knex": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@noble/curves": "~1.9.7",
    "@noble/hashes": "~1.8.0"
  }
}
