{
  "name": "vise-workflow-engine",
  "version": "2.0.0",
  "description": "Graph-based workflow engine with a drag-and-drop React editor. Typed blocks shared by server and editor, pluggable storage, framework-agnostic HTTP handler.",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./knex": {
      "import": {
        "types": "./dist/knex.d.mts",
        "default": "./dist/knex.mjs"
      },
      "require": {
        "types": "./dist/knex.d.ts",
        "default": "./dist/knex.js"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "require": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      }
    },
    "./react/style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "AGENT.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "dev:demo": "cd demo && npm run dev",
    "deploy:demo": "cd demo && npm run build && cd .. && npx gh-pages -d demo/dist"
  },
  "keywords": [
    "workflow",
    "state-machine",
    "graph",
    "editor",
    "reactflow",
    "express",
    "knex",
    "postgresql",
    "drag-and-drop",
    "react"
  ],
  "peerDependencies": {
    "knex": ">=2.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "reactflow": ">=11.10.0 <12"
  },
  "peerDependenciesMeta": {
    "knex": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "reactflow": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "better-sqlite3": "^11.10.0",
    "gh-pages": "^6.3.0",
    "knex": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@noble/curves": "~1.9.7",
    "@noble/hashes": "~1.8.0"
  }
}
